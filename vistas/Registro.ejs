<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="registro2.css">
    <title>Registro</title>
</head>
<body>
    

    <h2 class="Registro">Register</h2>
    
    <main class="textos">
        
    
        <form action="/" method="post">
            <label for="fname">Nombre :</label><br>
            <input type="text" name="Nombre" id="fname" placeholder="Ingresa Tu Nombre"><br><br>
            <label for="fname">Email :</label> <br>
            <input type="email" name="email" id="fname" placeholder="Ingresa Tu Email"><br><br>
            <label for="fname">Password :</label> <br>
            <input type="password" name="password" id="fname" placeholder="Ingresa tu Contraseña"><br><br>
            <label for="fname">Escriba Aqui :</label><br>
            <textarea id="Mensaje" name="Mensaje" rows="4" cols="50" placeholder="Escribe aquí..."></textarea><br><br>
            <input type="submit" value="Enviar">
        </form>
    </main>
</body>
</html>