<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="nigga2.css">
    <title>LogIn</title>
</head>
<body>
    

    <h2 class="Formulario">LogIn</h2>
    
    <main class="texto">
        
    
        <form action="/" method="post">
            <label for="fname">Nombre :</label><br>
            <input type="text" name="Nombre" id="fname" placeholder="Ingresa Tu Nombre"><br><br>
            <label for="fname">Email :</label> <br>
            <input type="email" name="email" id="fname" placeholder="Ingresa Tu Email"><br><br>
            <label for="fname">Password :</label> <br>
            <input type="password" name="password" id="fname" placeholder="Ingresa tu Contraseña"><br><br>
            <label for="fname">Genero :</label><br>
            <input type="radio" id="Masculino" name="Genero" value="Masculino">
            <label for="masculino">Masculino</label><br>
            <input type="radio" id="Masculino" name="Genero" value="Femenino">
            <label for="masculino">Femenino</label><br><br>
            <label for="fname">Provincia :</label><br>
            <select>
            <option>Buenos Aires</option>
            <option>San Luis</option>
            <option>Catamarca</option>
            <option>La Rioja</option>
            </select>
            <input type="submit" value="Enviar">
        </form>
    </main>
</body>
</html>